# Database (Supabase)
# For connection pooling (transactions & serverless) - use pooler port 6543
# IMPORTANT: Add ?pgbouncer=true&statement_cache_size=0 to your connection string
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0"
# For direct connection (migrations only) - use direct port 5432
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Hello.coop Authentication
# Get your client_id from https://console.hello.coop
HELLO_CLIENT_ID="your-hello-client-id"
# Generate with: openssl rand -hex 32
HELLO_COOKIE_SECRET="your-64-char-hex-string-generate-with-openssl-rand-hex-32"

# Twilio (SMS) - Optional
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Pusher (Real-time chat) - Optional
NEXT_PUBLIC_PUSHER_APP_KEY="your-pusher-app-key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_SECRET="your-pusher-secret"
