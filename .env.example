# Database
DATABASE_URL="postgresql://user:password@localhost:5432/shuckin?schema=public"

# Hello.coop Authentication
# Get your client_id from https://console.hello.coop
HELLO_CLIENT_ID="your-hello-client-id"
# Generate with: openssl rand -hex 32
HELLO_COOKIE_SECRET="your-64-char-hex-string-generate-with-openssl-rand-hex-32"

# Twilio (SMS) - Optional
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Pusher (Real-time chat) - Optional
NEXT_PUBLIC_PUSHER_APP_KEY="your-pusher-app-key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_SECRET="your-pusher-secret"
